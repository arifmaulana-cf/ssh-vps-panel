# Salin ke .env lalu sesuaikan. File .env dibuat otomatis saat pertama kali
# aplikasi dijalankan (password admin & session secret di-generate acak).

PORT=3000
HOST=0.0.0.0

# Kredensial admin panel
ADMIN_USER=admin
ADMIN_PASS=

# Kunci penanda tangan cookie sesi (acak, 64 karakter hex)
SESSION_SECRET=

# Masa berlaku cookie sesi login (menit)
SESSION_TTL_MINUTES=480

# Masa berlaku satu sesi SSH sebelum otomatis diputus (menit)
SSH_TTL_MINUTES=30

# Jumlah sesi SSH maksimal per user
MAX_SESSIONS_PER_USER=5

# Batas waktu koneksi ke VPS tujuan (ms)
CONNECT_TIMEOUT_MS=20000

# Verifikasi host key SSH:
#   tofu  = Trust On First Use (default, direkomendasikan)
#   false = tidak verifikasi sama sekali (JANGAN untuk produksi)
TRUST_HOST_KEY=tofu

# Batas akses File Manager. Nilai kosong berarti "/" (seluruh server).
# Set ke "/home/ubuntu" bila panel ini hanya untuk mengelola satu user.
FS_ROOT=/

# Maksimal ukuran upload lewat File Manager (byte)
MAX_UPLOAD_BYTES=67108864